# =============================================================================
# bwwatch settings
#
# The guided installer (./install.sh) creates and fills in this file for you. Edit it
# by hand only for advanced options, then run  ./bwctl restart  so the service reads it
# again. By hand:   cp .env.example .env && chmod 600 .env       then edit .env
#
# .env stays on YOUR server and is git-ignored. Do not paste it into chat,
# issues or screenshots.
#
# SIGN-IN OPTIONS:
#   Option A (Automated / Headless - Recommended for VPS):
#     Set BW_USERNAME and BW_PASSWORD (or USER and PASS) below. bwwatch will
#     automatically log in headlessly using Bradford White's Azure AD B2C service
#     with NO browser or website needed on the VPS.
#   Option B (Browser sign-in):
#     Run  ./bwctl login  and paste the redirect link once.
#   Option C (Token seed):
#     Set BW_REFRESH_TOKEN below or copy an existing data/token.json file.
#
# Format: NAME=value, one per line, no spaces around "=", and nothing after the
# value on the same line (put comments on their own line).
# If a value contains # or $, wrap it in single quotes:  NAME='pa$$word'
# Lines starting with # are comments; a blank value means "not set".
# =============================================================================

# Wave account credentials for automated headless login (optional):
# BW_USERNAME=
# BW_PASSWORD=
# (or USER= and PASS=)


# ----- 1. WHERE ALERTS GO  (set at least one) ---------------------------------

# ntfy - free push notifications to your phone. Install the "ntfy" app (Android/iOS)
# and subscribe to your topic name. On ntfy.sh the topic name is the only thing
# protecting your alerts, so make it long and random:   openssl rand -hex 12
NTFY_TOPIC=
# Your own ntfy server instead of ntfy.sh:
# NTFY_URL=https://ntfy.sh
# Access token for a protected topic (or use NTFY_USER and NTFY_PASSWORD instead):
# NTFY_TOKEN=
# NTFY_USER=
# NTFY_PASSWORD=

# Home Assistant - a webhook trigger in an automation (see README, "Home Assistant").
# Paste the whole webhook address, e.g.  https://your-home.example/api/webhook/<webhook_id>
# The webhook id inside it works like a password: keep it secret.
HA_WEBHOOK_URL=

# Telegram - create a bot with @BotFather, then message it and read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_API_BASE=https://api.telegram.org

# Email (SMTP). For Gmail use smtp.gmail.com, port 587, starttls and an "app password".
# When SMTP_HOST is set, SMTP_TO is required too.
SMTP_HOST=
# SMTP_PORT=587
# One of: starttls, ssl, none
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# One or more addresses, comma separated:
# SMTP_TO=you@example.com

# Any other service that accepts a JSON POST (Slack, Discord, Mattermost, your own).
WEBHOOK_URL=
# One of: json, slack, discord
# WEBHOOK_FORMAT=json

# Optional: limit what each channel receives. Kinds of alert:
#   fault      a new fault was detected
#   health     bwwatch itself is failing / needs you to sign in again
#   recovered  bwwatch is working again
#   cleared    a fault flag in the status data went away
#   setting    the heater's mode or setpoint changed
#   info       start-up and "now watching" messages
# Example - send only faults and problems to Home Assistant:
# HA_WEBHOOK_EVENTS=fault,health
# NTFY_EVENTS=fault,health,recovered
# TELEGRAM_EVENTS=fault,health
# SMTP_EVENTS=fault,health
# WEBHOOK_EVENTS=fault,health

# Optional dead-man's switch: an address (e.g. from healthchecks.io) that bwwatch
# pings after every good poll. If pings stop - the server died, the network is
# down - the service alerts you from outside. Keep the address secret.
HEARTBEAT_URL=


# ----- 2. THE FAULT / NOTIFICATIONS REQUEST  (the one thing you must find) -----
#
# The Wave app's "Notifications" tab loads its list with a request that has not been
# publicly documented. Until you set it, bwwatch can only see the heater's settings and
# fault-like fields inside the status data. README -> "Finding the fault request".
#
# Format:   METHOD /path?query [json body]       placeholders: {account_id} {mac} {serial} {name}
# Verified for Bradford White Wave (Aerotherm heat pump water heaters):
#   BW_FAULT_REQUEST=GET /wave/getApplianceErrors?mac_address={mac}
#
# (Note: snake_case mac_address is required by the Wave API; CamelCase returns HTTP 400.
#  If left blank, bwwatch automatically tries and learns this endpoint on first poll).
BW_FAULT_REQUEST=

# Tuning the fault parser, only if `check` says it could not read the response.
# Where the list of entries is, e.g. data.notifications:
# BW_FAULT_LIST_PATH=
# Which field holds the fault code, the time it happened, and the description:
# BW_FAULT_CODE_FIELD=
# BW_FAULT_TIME_FIELD=
# BW_FAULT_TEXT_FIELD=
# Fields that identify an entry, comma separated:
# BW_FAULT_ID_FIELDS=
# Only treat entries matching this regular expression as faults:
# BW_FAULT_MATCH=fault|error
# Keys to ignore when comparing responses (read flags, request ids), comma separated:
# BW_VOLATILE_KEYS=requestId,read

# Also watch the status data for fault-looking fields (faultCode, errorState, ...):
# BW_SCAN_STATUS=true
# Regular expression of field names to leave alone:
# BW_SCAN_IGNORE=(?i)enabled|support

# Only if the default requests stop working (the Wave API changed):
# BW_LIST_REQUEST=GET /wave/getApplianceList?username={account_id}
# BW_STATUS_REQUEST=GET /wave/getApplianceStatus?macAddress={mac}
# Extra headers on every Wave API request, as JSON:
# BW_EXTRA_HEADERS={"X-Example": "value"}
# Only if the sign-in token carries no account id:
# BW_ACCOUNT_ID=


# ----- 3. HOW IT BEHAVES --------------------------------------------------------

# HOW OFTEN to ask the Wave cloud, in seconds. 3600 = hourly (the default), 900 = every 15 minutes.
# The minimum is 300 (5 minutes) and cannot be lowered, so the cloud is never hammered. Each poll
# is about 4 small requests; see README, "How often it contacts Bradford White". To change it:
# edit this line, then  ./bwctl restart  (or  docker compose up -d  in /opt/bwheater).
BW_POLL_INTERVAL_SECONDS=3600

# While a fault from the Notifications list is active, poll this often instead (seconds).
# Default 600 (10 minutes), never below 300, and only for BW_FAULT_POLL_HOURS after the fault was first seen.
# BW_FAULT_POLL_INTERVAL_SECONDS=600
# BW_FAULT_POLL_HOURS=12

# Keep a log of EVERY field the cloud reports (value, and each change with its time) so that
# when a fault happens you can see what else changed around it:  ./bwctl fields  and
# ./bwctl changes --around "2026-10-04 13:15". Nothing is written for a field that did not change.
# BW_LOG_FIELDS=true
# Log energy usage per hour and day (heat pump vs backup element in kWh):  ./bwctl energy
# BW_LOG_ENERGY=true
# Send an alert when a field whose name matches this pattern changes (a regular expression
# on "source.path", e.g.  status\.(compressor|error|fault)  ). Leave unset to log silently.
# BW_WATCH_FIELDS=
# How many days of field-change history to keep (0 = forever; default 365). Faults are never deleted.
# BW_KEEP_HISTORY_DAYS=365

# Time zone for times shown in alerts (a name such as America/Chicago). Stored times are UTC.
DISPLAY_TZ=UTC

# Alert on changes of the heater's mode / setpoint (e.g. dropping out of Heat Pump mode)?
# NOTIFY_STATUS_CHANGES=true
# Alert when a fault clears (a Notifications entry turns to "(Cleared)", or a fault-like status flag goes away)?
# NOTIFY_CLEARED=true
# 1 (quiet) .. 5 (urgent) for fault alerts:
# FAULT_PRIORITY=4
# More new faults than this in one poll are summarised in one alert:
# MAX_ALERTS_PER_CYCLE=5
# Retry an undelivered alert this often (seconds):
# NOTIFY_RETRY_SECONDS=300
# Failed polls in a row before "monitoring is failing", and the reminder interval after that:
# HEALTH_ALERT_AFTER_FAILURES=3
# HEALTH_REPEAT_HOURS=12

# Database safety net: a verified backup this often (hours), keeping this many.
# BACKUP_EVERY_HOURS=24
# BACKUP_KEEP=14

# DEBUG shows every request (never tokens):
# LOG_LEVEL=INFO
# A small rotating log (about 5 MB at most) is kept inside the data folder. Set this to a
# different path inside the container, or leave it empty to turn the file log off:
# LOG_FILE=/data/logs/bwwatch.log


# ----- 4. ADVANCED - normally leave alone ----------------------------------------
# A refresh token obtained some other way, used once to start the sign-in. The login
# command is easier and keeps it in ./data; the value here goes stale as tokens rotate.
# BW_REFRESH_TOKEN=
# BW_API_BASE=https://gw.prdapi.bradfordwhiteapps.com
# BW_AUTH_BASE=https://consumer.bradfordwhiteapps.com/consumer.bradfordwhiteapps.com/B2C_1_Wave_SignIn/oauth2/v2.0
# BW_CLIENT_ID=7899415d-1c23-46d8-8a79-4c15ed5f7f22
# BW_REDIRECT_URI=com.bradfordwhiteapps.bwconnect://oauth/redirect
# BW_SCOPE=openid email offline_access profile
# BW_USER_AGENT=Dart/3.8 (dart:io)
# BW_HTTP_TIMEOUT_SECONDS=20
# Testing only - allows plain http:// to the Wave servers:
# BW_ALLOW_INSECURE_HTTP=false
